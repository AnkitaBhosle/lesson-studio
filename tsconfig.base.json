{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "paths": {
      "@ls/schema": ["./packages/schema/src/index.ts"],
      "@ls/schema/*": ["./packages/schema/src/*"],
      "@ls/orchestrator": ["./packages/orchestrator/src/index.ts"],
      "@ls/agents": ["./packages/agents/src/index.ts"],
      "@ls/models": ["./packages/models/src/index.ts"],
      "@ls/media": ["./packages/media/src/index.ts"],
      "@ls/fixtures": ["./fixtures/seed/index.ts"]
    }
  }
}
